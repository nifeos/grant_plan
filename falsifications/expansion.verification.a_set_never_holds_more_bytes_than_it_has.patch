-        self.n < MAXIMUM_NAMES && self.name_bytes() + len <= MAXIMUM_NAME_SET_BYTES
+        self.n < MAXIMUM_NAMES && self.name_bytes() + len <= MAXIMUM_NAME_SET_BYTES + MAXIMUM_NAME_BYTES
     }
 
